# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your-gemini-api-key"



# SUPABASE_URL: Your Supabase project URL
VITE_SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_ANON_KEY: Your Supabase anonymous API key
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Backend Environment Variables
DATABASE_URL="postgresql://user:password@localhost:5432/job_portal?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Supabase Storage — private bucket holding candidate CVs.
# The service-role key bypasses row-level security and must stay server-side.
# It is deliberately NOT prefixed VITE_: Vite inlines every VITE_* value into
# the browser bundle, so a service-role key under that prefix would be handed
# to every visitor. Supabase > Project Settings > API > service_role (secret).
# The bucket is created automatically on first upload, private, 10 MB cap.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_CV_BUCKET="cvs"

# Email Configuration
#
# RESEND_API_KEY: the transport actually used. Mail goes over HTTPS to
# Resend's API, because mail.darlemploi.dz refuses SMTP connections from
# outside the hosting account — from a developer machine and from a Vercel
# function alike. Create a key at resend.com > API Keys (Sending access).
# When this is set, the SMTP_* and EMAIL_PASS values below are ignored.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- SMTP fallback, used only when RESEND_API_KEY is unset ---
# SMTP_HOST: your domain mail server (cPanel/OVH/Hostinger). Leave unset to
# fall back to Gmail. Strongly preferred for @darlemploi.dz addresses, which
# Gmail cannot send as without a verified alias and which fail SPF/DKIM when
# relayed by Google.
SMTP_HOST="mail.darlemploi.dz"
SMTP_PORT="465"        # 465 = SSL/TLS, 587 = STARTTLS
SMTP_SECURE="true"     # optional; derived from the port when omitted

# EMAIL_USER: the mailbox we authenticate to SMTP as (the FULL address).
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-gmail-app-password"
CONTACT_EMAIL="your-email@gmail.com"

# EMAIL_FROM: address registration mail is sent FROM.
# With Resend it must sit on a domain verified under Resend > Domains.
# Before that verification the only permitted sender is onboarding@resend.dev,
# which delivers solely to the Resend account's own address — enough to test
# with, useless for real users, so verify the domain.
# On the SMTP fallback it must instead be a verified alias of EMAIL_USER,
# or Gmail silently rewrites it back to EMAIL_USER.
EMAIL_FROM="inscription@darlemploi.dz"
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect
# ---------------------------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application). See docs/GOOGLE_AUTH_SETUP.md.
#
# Leave these unset to disable Google sign-in; email + password login is
# unaffected either way.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Must match an Authorized redirect URI in Google Cloud EXACTLY, including
# scheme, host, port and path.
#   dev  : http://localhost:5000/api/auth/google/callback
#   prod : https://www.darlemploi.dz/api/auth/google/callback
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# Where the OAuth callback sends the browser afterwards. Also the allow-list
# for post-login redirects — user-supplied redirect targets are never honoured.
FRONTEND_URL="http://localhost:5000"
