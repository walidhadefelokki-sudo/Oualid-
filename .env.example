# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your-gemini-api-key"



# SUPABASE_URL: Your Supabase project URL
VITE_SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_ANON_KEY: Your Supabase anonymous API key
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Backend Environment Variables
DATABASE_URL="postgresql://user:password@localhost:5432/job_portal?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Email Configuration
# EMAIL_USER: the mailbox we authenticate to SMTP as.
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-gmail-app-password"
CONTACT_EMAIL="your-email@gmail.com"

# EMAIL_FROM: address registration mail is sent FROM. Must be a verified
# alias on EMAIL_USER, or Gmail rewrites it back to EMAIL_USER.
EMAIL_FROM="inscription@darlemploi.dz"
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect
# ---------------------------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application). See docs/GOOGLE_AUTH_SETUP.md.
#
# Leave these unset to disable Google sign-in; email + password login is
# unaffected either way.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Must match an Authorized redirect URI in Google Cloud EXACTLY, including
# scheme, host, port and path.
#   dev  : http://localhost:5000/api/auth/google/callback
#   prod : https://www.darlemploi.dz/api/auth/google/callback
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# Where the OAuth callback sends the browser afterwards. Also the allow-list
# for post-login redirects — user-supplied redirect targets are never honoured.
FRONTEND_URL="http://localhost:5000"
