// ======================================================
// Dar L'Emploi
// Production Prisma Schema
// PART 1 - Core Identity
// ======================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum RecruiterPlan {
  FREE
  PREMIUM
  CORPORATE
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  HR_MANAGER
  RECRUITER
}

enum Language {
  FR
  EN
  AR
}

// ======================================================
// Dar L'Emploi
// Production Prisma Schema
// PART 2 - Recruitment Module
// Append this after Part1_Core_Identity.prisma
// ======================================================

//////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
  TEMPORARY
}

enum ExperienceLevel {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  INTERVIEW
  HIRED
  REJECTED
}

// ======================================================
// Dar L'Emploi
// Production Prisma Schema
// PART 3 - AI Recruitment Module
// Append after Part2_Recruitment.prisma
// ======================================================

//////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////

enum AIAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum QuizStatus {
  PENDING

  GENERATED

  IN_PROGRESS

  SUBMITTED

  REVIEWED
}

enum QuizDifficulty {
  EASY

  MEDIUM

  HARD
}

enum OralPresentationStatus {
  PENDING
  UPLOADED
  REVIEWED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ======================================================
// Dar L'Emploi
// Production Prisma Schema
// PART 4 - Business Platform
// Append after Part3_AI_Recruitment.prisma
// ======================================================

//////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CCP
  CASH
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

//////////////////////////////////////////////////////////
// SUBSCRIPTION
//////////////////////////////////////////////////////////

model Subscription {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  plan RecruiterPlan

  status SubscriptionStatus @default(ACTIVE)

  startsAt DateTime
  endsAt   DateTime

  autoRenew Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([companyId])
}

//////////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////////

model Payment {
  id String @id @default(uuid())

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount   Float
  currency String @default("DZD")

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  transactionId String?

  paidAt DateTime?

  createdAt DateTime @default(now())

  @@index([subscriptionId])
}

//////////////////////////////////////////////////////////
// NOTIFICATION
//////////////////////////////////////////////////////////

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String

  type NotificationType @default(INFO)

  read Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
}

//////////////////////////////////////////////////////////
// AUDIT LOG
//////////////////////////////////////////////////////////

model AuditLog {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action   String
  entity   String
  entityId String?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
}

//////////////////////////////////////////////////////////
// SUPPORT TICKET
//////////////////////////////////////////////////////////

model SupportTicket {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject     String
  description String

  status TicketStatus @default(OPEN)

  priority String @default("NORMAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

//////////////////////////////////////////////////////////
// PLATFORM SETTINGS
//////////////////////////////////////////////////////////

model PlatformSetting {
  id String @id @default(uuid())

  key String @unique

  value Json

  description String?

  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////////
// DEVICE TOKEN
//////////////////////////////////////////////////////////

model DeviceToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String @unique

  platform String

  createdAt DateTime @default(now())

  @@index([userId])
}

//////////////////////////////////////////////////////////
// AI ANALYSIS
//////////////////////////////////////////////////////////

model AIAnalysis {
  id String @id @default(uuid())

  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  status AIAnalysisStatus @default(PENDING)

  overallScore    Float?
  skillsScore     Float?
  experienceScore Float?
  educationScore  Float?
  languageScore   Float?

  extractedSkills    String[]
  extractedLanguages String[]
  strengths          String[]
  weaknesses         String[]
  recommendations    String[]

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([candidateId])
}

//////////////////////////////////////////////////////////
// QUIZ
//////////////////////////////////////////////////////////

model Quiz {
  id String @id @default(cuid())

  candidateId String @unique
  candidate   User   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  status QuizStatus @default(PENDING)

  generatedAt DateTime  @default(now())
  submittedAt DateTime?

  aiModel String?

  questions QuizQuestion[]

  attempt QuizAttempt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////////
// QUIZ QUESTION
//////////////////////////////////////////////////////////

model QuizQuestion {
  id String @id @default(cuid())

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  order Int

  question String @db.Text

  skill String?

  difficulty QuizDifficulty @default(MEDIUM)

  answers QuizAnswer[]

  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////////////
// QUIZ ATTEMPT
//////////////////////////////////////////////////////////

model QuizAttempt {
  id String @id @default(cuid())

  quizId String @unique
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  candidateId String
  candidate   User   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  aiScore        Float?
  recruiterScore Float?

  feedback String? @db.Text

  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers QuizAnswer[]
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model QuizAnswer {
  id String @id @default(cuid())

  attemptId String
  attempt   QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answer String @db.Text

  aiScore Float?

  recruiterScore Float?

  aiFeedback String? @db.Text

  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////////////
// ORAL PRESENTATION
//////////////////////////////////////////////////////////

model OralPresentation {
  id String @id @default(uuid())

  candidateId String           @unique
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id])

  videoId String?
  video   FileAsset? @relation(fields: [videoId], references: [id])

  recruiterScore Float?

  status OralPresentationStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////////
// INTERVIEW
//////////////////////////////////////////////////////////

model Interview {
  id String @id @default(uuid())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  scheduledAt DateTime

  durationMinutes Int?

  interviewer String?

  meetingUrl String?

  notes String?

  score Float?

  status InterviewStatus @default(SCHEDULED)

  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////////////
// CANDIDATE SCORE
//////////////////////////////////////////////////////////

model CandidateScore {
  id String @id @default(uuid())

  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  aiScore               Float?
  quizScore             Float?
  oralPresentationScore Float?
  interviewScore        Float?
  recruiterScore        Float?

  finalScore Float?

  rank Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
}

//////////////////////////////////////////////////////////
// JOB CATEGORY
//////////////////////////////////////////////////////////

model JobCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?
  icon        String?

  jobs Job[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  // --- Freelance marketplace -------------------------------------------
  // Shared with recruitment on purpose: one sector list, one admin screen.
  services          ServiceListing[]    @relation("ServiceCategory")
  freelanceProjects FreelanceProject[]  @relation("ProjectCategory")
  freelancers       FreelancerProfile[] @relation("FreelancerCategory")
  portfolioProjects PortfolioProject[]  @relation("PortfolioProjectCategory")

  /// Subcategories. A category with a parent is a subcategory of it.
  parentId String?
  parent   JobCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children JobCategory[] @relation("CategoryTree")
}

//////////////////////////////////////////////////////////
// SKILL
//////////////////////////////////////////////////////////

model Skill {
  id          String  @id @default(uuid())
  name        String  @unique
  category    String?
  description String?

  jobs JobSkill[]

  createdAt   DateTime          @default(now())
  // --- Freelance marketplace -------------------------------------------
  freelancers FreelancerSkill[]
  services    ServiceSkill[]
  projects    ProjectSkill[]
}

//////////////////////////////////////////////////////////
// JOB
//////////////////////////////////////////////////////////

model Job {
  id String @id @default(uuid())

  recruiterId String
  recruiter   RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  categoryId String?
  category   JobCategory? @relation(fields: [categoryId], references: [id])

  title       String
  slug        String @unique
  description String

  location String
  wilaya   String?
  country  String?

  remote Boolean @default(false)

  type            JobType
  experienceLevel ExperienceLevel

  vacancies Int @default(1)

  salaryMin Int?
  salaryMax Int?
  currency  String @default("DZD")

  featured Boolean @default(false)
  urgent   Boolean @default(false)

  status JobStatus @default(PUBLISHED)

  publishedAt DateTime?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills       JobSkill[]
  applications Application[]
  savedBy      SavedJob[]

  @@index([companyId])
  @@index([recruiterId])
  @@index([status])
}

//////////////////////////////////////////////////////////
// JOB SKILL
//////////////////////////////////////////////////////////

model JobSkill {
  jobId   String
  skillId String

  required Boolean @default(true)

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
}

//////////////////////////////////////////////////////////
// APPLICATION
//////////////////////////////////////////////////////////

model Application {
  id String @id @default(uuid())

  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  recruiterId String
  recruiter   RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  cvId String?
  cv   FileAsset? @relation(fields: [cvId], references: [id])

  coverLetter String?

  status ApplicationStatus @default(PENDING)

  aiScore               Float?
  quizScore             Float?
  oralPresentationScore Float?
  recruiterScore        Float?
  finalScore            Float?

  preselectionStatus PreselectionStatus @default(PENDING)

  isPreselected Boolean @default(false)

  preselectionScore Float?

  preselectionComment String?

  preselections Preselection[]

  appliedAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  aianalysis     AIAnalysis?
  interviews     Interview[]
  candidateScore CandidateScore?

  @@index([candidateId])
  @@index([recruiterId])
  @@index([jobId])
}

//////////////////////////////////////////////////////////
// SAVED JOB
//////////////////////////////////////////////////////////

model SavedJob {
  id String @id @default(uuid())

  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([candidateId, jobId])
}

//////////////////////////////////////////////////////////
// FAVORITE COMPANY
//////////////////////////////////////////////////////////

model FavoriteCompany {
  id String @id @default(uuid())

  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([candidateId, companyId])
}

model FileAsset {
  id        String   @id @default(uuid())
  url       String
  provider  String
  publicId  String?
  /// The name the candidate's own file had, kept for display only. Never
  /// used to build a storage path — an upload-supplied name is how path
  /// traversal and object overwrites happen.
  fileName  String?
  mimeType  String?
  extension String?
  size      Int?
  createdAt DateTime @default(now())

  avatars                User[]                  @relation("UserAvatar")
  resumes                CandidateProfile[]      @relation("CandidateResume")
  logos                  Company[]               @relation("CompanyLogo")
  oralPresentations      OralPresentation[]
  applications           Application[]
  // --- Freelance marketplace -------------------------------------------
  serviceMedia           ServiceMedia[]          @relation("ServiceMedia")
  projectAttachments     ProjectAttachment[]     @relation("ProjectAttachment")
  proposalAttachments    ProposalAttachment[]    @relation("ProposalAttachment")
  deliveryFiles          DeliveryFile[]          @relation("DeliveryFile")
  messageAttachments     MessageAttachment[]     @relation("MessageAttachment")
  portfolioCovers        Portfolio[]             @relation("PortfolioCover")
  portfolioProjectCovers PortfolioProject[]      @relation("PortfolioProjectCover")
  portfolioMedia         PortfolioProjectMedia[] @relation("PortfolioMedia")
  paymentReceipts        MarketplacePayment[]    @relation("PaymentReceipt")
  invoiceFiles           MarketplaceInvoice[]    @relation("InvoiceFile")
  verificationDocuments  IdentityVerification[]  @relation("VerificationDocument")
  verificationSelfies    IdentityVerification[]  @relation("VerificationSelfie")
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  // Nullable since Google-only accounts have no local password. Storing a
  // random or predictable placeholder would make a password-shaped value that
  // is never a real credential; null states plainly that this user signs in
  // through a provider. `login` rejects an account with no password and points
  // the user at the provider instead.
  password      String?
  role          Role          @default(CANDIDATE)
  status        AccountStatus @default(PENDING)
  emailVerified Boolean       @default(false)

  firstName         String?
  lastName          String?
  phone             String?
  preferredLanguage Language @default(FR)

  avatarId String?
  avatar   FileAsset? @relation("UserAvatar", fields: [avatarId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  candidateProfile CandidateProfile?
  recruiterProfile RecruiterProfile?

  quiz         Quiz?
  quizAttempts QuizAttempt[]

  refreshTokens   RefreshToken[]
  sessions        UserSession[]
  accounts        Account[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  supportTickets  SupportTicket[]
  ownedLeads      Lead[]          @relation("LeadOwner")
  convertedFrom   Lead[]          @relation("LeadConverted")
  crmNotesWritten CrmNote[]       @relation("CrmNoteAuthor")
  crmNotesAbout   CrmNote[]       @relation("CrmNoteSubject")
  deviceTokens    DeviceToken[]

  packOrders             PackOrder[]               @relation("PackOrderBuyer")
  schedulesHosted        ScheduleEvent[]           @relation("ScheduleHost")
  schedulesCreated       ScheduleEvent[]           @relation("ScheduleCreator")
  scheduleGuest          ScheduleGuest[]           @relation("ScheduleGuest")
  // --- Freelance marketplace -------------------------------------------
  freelancerProfile      FreelancerProfile?
  freelanceProjects      FreelanceProject[]        @relation("ProjectClient")
  clientOrders           FreelanceOrder[]          @relation("OrderClient")
  orderEvents            OrderEvent[]              @relation("OrderEventActor")
  creditWallet           CreditWallet?
  ledgerEntriesCreated   CreditLedgerEntry[]       @relation("LedgerActor")
  freelanceSubscriptions FreelanceSubscription[]
  marketplacePayments    MarketplacePayment[]
  paymentsReviewed       MarketplacePayment[]      @relation("PaymentReviewer")
  conversations          ConversationParticipant[]
  messagesSent           Message[]                 @relation("MessageSender")
  reviewsWritten         FreelanceReview[]         @relation("ReviewAuthor")
  reviewsReceived        FreelanceReview[]         @relation("ReviewTarget")
  reportsFiled           Report[]                  @relation("ReportReporter")
  reportsAbout           Report[]                  @relation("ReportedUser")
  reportsResolved        Report[]                  @relation("ReportResolver")
  disputesOpened         Dispute[]                 @relation("DisputeOpener")
  disputesAssigned       Dispute[]                 @relation("DisputeAssignee")
  moderationActions      ModerationRecord[]        @relation("ModerationActor")
  verificationsReviewed  IdentityVerification[]    @relation("VerificationReviewer")
  // --- Freelance, second increment -------------------------------------
  /// "Téléphone vérifié" is one of the three badges the specification names.
  phoneVerifiedAt        DateTime?

  favorites               Favorite[]
  customOffersReceived    CustomOffer[]          @relation("CustomOfferClient")
  promoRedemptions        PromoCodeRedemption[]
  staffMembership         StaffMember?
  impersonationsPerformed ImpersonationSession[] @relation("ImpersonationStaff")
  impersonationsOfMe      ImpersonationSession[] @relation("ImpersonationTarget")
  cmsEdits                CmsContent[]           @relation("CmsEditor")

  /// Which side of the platform this account was created on.
  ///
  /// The account itself is shared — one login for jobs and freelance, as
  /// the specification requires — but a marketplace signup is not a job
  /// applicant, and the recruitment admin should be able to tell them
  /// apart rather than counting them as candidates who never applied.
  signupSource String @default("JOBS")

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  browser   String?
  os        String?
  device    String?
  lastSeen  DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model CandidateProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  headline  String?
  bio       String?
  phone     String?
  city      String?
  wilaya    String?
  country   String?
  birthDate DateTime?

  resumeId String?
  resume   FileAsset? @relation("CandidateResume", fields: [resumeId], references: [id])

  // Structured data behind the in-app CV Maker (name, summary, experiences,
  // education, skills, languages + levels). Stored as JSON rather than
  // normalised tables because it is a document the candidate edits as a
  // whole, and its shape is owned by the CV Maker UI. Distinct from
  // `resume` above, which is an uploaded PDF file.
  cvBuilderData Json?

  skills               String[]
  yearsExperience      Int?
  currentJobTitle      String?
  desiredSalary        Int?
  availableImmediately Boolean  @default(true)

  linkedinUrl  String?
  githubUrl    String?
  portfolioUrl String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  aianalyses        AIAnalysis[]
  candidateScores   CandidateScore[]
  applications      Application[]
  savedJobs         SavedJob[]
  favoriteCompanies FavoriteCompany[]
  oralPresentation  OralPresentation?

  @@index([userId])
}

model RecruiterProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone    String?
  jobTitle String?
  verified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies     CompanyMember[]
  jobs          Job[]
  applications  Application[]
  preselections Preselection[]

  @@index([userId])
}

model Company {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  website     String?
  industry    String?
  size        String?
  foundedYear Int?
  country     String?
  city        String?
  address     String?

  logoId String?
  logo   FileAsset? @relation("CompanyLogo", fields: [logoId], references: [id])

  plan     RecruiterPlan @default(FREE)
  verified Boolean       @default(false)

  /// Paid job postings still available, bought as annonce packs.
  ///
  /// Only consumed on PREMIUM: FREE is capped at a single offer regardless,
  /// and CORPORATE publishes without limit, so neither touches this balance.
  postingCredits Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           CompanyMember[]
  subscriptions     Subscription[]
  packOrders        PackOrder[]
  jobs              Job[]
  favoriteCompanies FavoriteCompany[]
  // --- Freelance marketplace -------------------------------------------
  // An existing employer hires freelancers from the same business account.
  freelanceProjects FreelanceProject[] @relation("ProjectCompany")
  /// "Entreprise vérifiée (registre de commerce / NIF)" — the third badge.
  /// Held here rather than on the freelance side because it is the company
  /// that is verified, and the same company hires employees too.
  registreCommerce  String?
  nif               String?
  verifiedAt        DateTime?

  @@index([slug])
}

model CompanyMember {
  id          String            @id @default(uuid())
  companyId   String
  recruiterId String
  role        CompanyMemberRole

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruiter RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([companyId, recruiterId])
  @@index([companyId])
  @@index([recruiterId])
}

//////////////////////////////////////////////////////////
// PRESELECTION
//////////////////////////////////////////////////////////

model Preselection {
  id String @id @default(uuid())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  recruiterId String
  recruiter   RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  status PreselectionStatus @default(PENDING)

  aiScore Float?

  recruiterScore Float?

  finalScore Float?

  comment String?

  reviewedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([recruiterId])
  @@index([status])
}

enum PreselectionStatus {
  PENDING
  SHORTLISTED
  REJECTED
}

/// A third-party identity linked to a User (currently Google).
///
/// Kept separate from User so one person can sign in several ways without
/// duplicate identities: the User row is the application's single identity,
/// and each Account row records one external provider that maps to it.
/// Adding another provider later needs no schema change.
model Account {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Provider key, e.g. "google".
  provider          String
  /// The provider's own immutable id for this user (Google's `sub`).
  /// Deliberately not the email: an email can be reassigned, `sub` cannot.
  providerAccountId String

  /// Email reported by the provider at link time, kept for auditing only —
  /// never used to authenticate.
  providerEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Stops the same provider identity being attached to two Users, which is
  /// the database-level guarantee behind duplicate-account prevention.
  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ============================================================
// CRM
// ============================================================

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum LeadSource {
  INBOUND
  OUTBOUND
  REFERRAL
  EVENT
  SOCIAL
  OTHER
}

/// A prospective client — usually a company that has not signed up yet.
///
/// Deliberately not a User: a lead is someone the team is talking to, who may
/// never create an account. Once they do, `convertedUserId` links the two so
/// the history of the conversation survives the conversion.
model Lead {
  id String @id @default(uuid())

  companyName String
  contactName String?
  email       String?
  phone       String?

  status LeadStatus @default(NEW)
  source LeadSource @default(INBOUND)

  /// Free-text summary. Dated interactions belong in CrmNote.
  notes String?

  /// Admin responsible for the relationship.
  ownerId String?
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  /// Set when the lead signs up, so their pre-signup history is not orphaned.
  convertedUserId String?
  convertedUser   User?     @relation("LeadConverted", fields: [convertedUserId], references: [id], onDelete: SetNull)
  convertedAt     DateTime?

  /// When someone should follow up.
  nextActionAt DateTime?

  crmNotes CrmNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ownerId])
}

/// One dated interaction: a call, an email, a meeting, a note.
///
/// Attaches to a Lead or to an existing User (a recruiter or a candidate), so
/// the same relationship history works before and after someone signs up.
/// Exactly one of the two is set.
model CrmNote {
  id String @id @default(uuid())

  body String

  /// Who wrote it. Kept even if they leave, hence SetNull rather than Cascade.
  authorId String?
  author   User?   @relation("CrmNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// The recruiter or candidate this note is about.
  subjectId String?
  subject   User?   @relation("CrmNoteSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([subjectId])
}

/// A purchase of an annonce pack through Chargily Pay.
///
/// The row is created *before* the customer is sent to the checkout, holding
/// the price the server decided on. That is the whole point: the client only
/// ever names a pack id, so a price edited in the browser has nothing to act
/// on — the amount charged and the amount recorded both come from the server's
/// own catalogue.
///
/// It doubles as the invoice: once Chargily confirms payment the row gets an
/// invoiceNumber and paidAt, and the PDF is rendered from it on demand rather
/// than stored.
model PackOrder {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Who started the purchase. Kept if they leave the company.
  buyerId String?
  buyer   User?   @relation("PackOrderBuyer", fields: [buyerId], references: [id], onDelete: SetNull)

  /// Catalogue id (pack-1, pack-2, pack-5, pack-10), for the record.
  packId   String
  /// Annonces this pack grants, copied at purchase time so a later catalogue
  /// change cannot rewrite what someone already bought.
  jobs     Int
  /// Whole dinars, as sent to Chargily.
  amount   Int
  currency String @default("dzd")

  status PackOrderStatus @default(PENDING)

  /// Chargily's checkout id. Unique so a replayed webhook cannot be applied
  /// twice — the credit grant keys off this.
  checkoutId  String? @unique
  checkoutUrl String?

  /// Assigned only once paid, so invoice numbers have no gaps for abandoned
  /// checkouts.
  invoiceNumber String? @unique

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([companyId])
  @@index([status])
}

enum PackOrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

/// A dated entry on the super admin's calendar.
///
/// Distinct from Interview, which hangs off an Application and belongs to the
/// recruiter hiring for it. This is the platform team's own diary: partner
/// meetings, demos, calls, deadlines — things with no application behind them.
model ScheduleEvent {
  id String @id @default(uuid())

  title String
  type  ScheduleType @default(MEETING)

  startsAt DateTime
  endsAt   DateTime
  /// Times are ignored when true; the entry covers whole days.
  allDay   Boolean  @default(false)

  /// A room, an address, or a meeting link — whatever fits the type.
  location String?
  notes    String?

  status ScheduleStatus @default(PLANNED)

  /// Who runs it. SetNull rather than Cascade: losing the host should not
  /// erase the meeting from everyone else's calendar.
  hostId String?
  host   User?   @relation("ScheduleHost", fields: [hostId], references: [id], onDelete: SetNull)

  /// Who put it in the diary, kept for the audit trail.
  createdById String?
  createdBy   User?   @relation("ScheduleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  guests ScheduleGuest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
  @@index([hostId])
}

/// One attendee of a ScheduleEvent.
///
/// A guest is either a platform account or a name and address typed in — a
/// client or partner who has never signed up is still someone to invite, and
/// requiring an account would make half the diary impossible to record.
model ScheduleGuest {
  id String @id @default(uuid())

  eventId String
  event   ScheduleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("ScheduleGuest", fields: [userId], references: [id], onDelete: SetNull)

  /// Used when there is no account behind the guest.
  name  String?
  email String?

  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([userId])
}

enum ScheduleType {
  MEETING
  INTERVIEW
  CALL
  DEMO
  DEADLINE
  OTHER
}

enum ScheduleStatus {
  PLANNED
  CONFIRMED
  DONE
  CANCELLED
}

//////////////////////////////////////////////////////////
// FREELANCE MARKETPLACE
//
// Dar L'Emploi Freelance extends the recruitment platform rather than
// standing beside it: one User, one login, one set of companies. A user is
// not a freelancer *or* a client — they hold a FreelancerProfile when they
// sell and act as a client through their own User row when they buy, so the
// same account does both without a second identity.
//
// Money is Decimal(12,2), never Float: a Float cannot hold 2500.10 exactly
// and these values are invoiced. Credits are whole numbers and live in an
// append-only ledger, because a balance that can be set rather than derived
// is a balance that can be argued with.
//////////////////////////////////////////////////////////

enum FreelancerAvailability {
  FULL_TIME
  PART_TIME
  OCCASIONAL
  UNAVAILABLE
}

/// Earned from real completed work and ratings, never self-assigned.
enum SellerLevel {
  NEW
  LEVEL_1
  LEVEL_2
  TOP_RATED
}

/// Shared by services, projects and portfolios — anything a moderator sees
/// before the public does.
enum ModerationState {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum ServiceStatus {
  DRAFT
  PENDING
  PUBLISHED
  PAUSED
  EXPIRED
  REJECTED
}

enum PackageTier {
  BASIC
  STANDARD
  PREMIUM
}

enum BudgetType {
  FIXED
  HOURLY
}

enum ProjectVisibility {
  PUBLIC
  INVITE_ONLY
}

enum FreelanceProjectStatus {
  DRAFT
  PENDING
  OPEN
  IN_PROGRESS
  CLOSED
  COMPLETED
  REJECTED
}

enum ProposalStatus {
  SENT
  VIEWED
  SHORTLISTED
  SELECTED
  REJECTED
  WITHDRAWN
}

enum FreelanceOrderStatus {
  CREATED
  IN_PROGRESS
  DELIVERED
  REVISION_REQUESTED
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
  APPROVED
}

/// Every reason a balance can move. Stored on an append-only ledger row so
/// the balance is a consequence of history rather than a number someone set.
enum CreditEntryType {
  PURCHASE
  SERVICE_PUBLICATION
  PROPOSAL_SUBMISSION
  BOOST_PURCHASE
  REFUND
  PROMOTION
  TRIAL_GRANT
  ADMIN_ADJUSTMENT
  EXPIRATION
}

enum MarketplacePaymentStatus {
  PENDING
  AWAITING_REVIEW
  PAID
  REJECTED
  FAILED
  REFUNDED
  EXPIRED
}

/// CCP and BaridiMob are receipt-and-review, not gateways: they produce a
/// pending payment a human approves, never an automatic credit grant.
enum MarketplacePaymentMethod {
  CHARGILY_CIB
  CHARGILY_EDAHABIA
  CCP_TRANSFER
  BARIDIMOB
  BANK_TRANSFER
  ADMIN_GRANT
}

enum FreelancePlanTier {
  FREE
  PRO
  PREMIUM
  /// Phase 3: team profile with shared credits.
  AGENCY
}

enum FreelanceSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BoostPlacement {
  HOMEPAGE
  CATEGORY
  PROPOSAL
}

enum PortfolioSectionType {
  HEADER
  ABOUT
  SKILLS
  FEATURED_PROJECTS
  SERVICES
  EXPERIENCE
  EDUCATION
  CERTIFICATES
  REVIEWS
  CONTACT
}

enum ReportReason {
  SCAM
  FAKE_PROFILE
  OFFENSIVE
  SUSPICIOUS_PAYMENT
  ABUSE
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

enum DisputeStatus {
  OPEN
  REVIEWING
  RESOLVED
  CLOSED
}

//////////////////////////////////////////////////////////
// FREELANCER PROFILE
//////////////////////////////////////////////////////////

model FreelancerProfile {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Public handle behind /@username. Unique and immutable-ish: it is the
  /// address a freelancer prints on a card.
  username String @unique

  displayName String
  title       String?
  bio         String?

  categoryId String?
  category   JobCategory? @relation("FreelancerCategory", fields: [categoryId], references: [id], onDelete: SetNull)

  wilaya    String?
  languages Language[]

  /// Per hour, in DZD. Optional: not every freelancer sells time.
  hourlyRate Decimal? @db.Decimal(12, 2)

  availability FreelancerAvailability @default(OCCASIONAL)

  /// Derived from completed orders and ratings by a scheduled recomputation.
  /// Never writable from the client.
  level SellerLevel @default(NEW)

  /// Set only by a passed verification review, never by the freelancer.
  identityVerified Boolean   @default(false)
  verifiedAt       DateTime?

  /// One free publication and a proposal allowance, once per account. Held
  /// here rather than inferred from the ledger so a user cannot earn another
  /// by deleting and recreating their profile.
  trialClaimedAt DateTime?

  completedOrders Int      @default(0)
  ratingAverage   Decimal? @db.Decimal(3, 2)
  ratingCount     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills        FreelancerSkill[]
  services      ServiceListing[]
  proposals     Proposal[]
  orders        FreelanceOrder[]        @relation("OrderFreelancer")
  portfolio     Portfolio?
  subscriptions FreelanceSubscription[]
  boosts        Boost[]
  verification  IdentityVerification?
  customOffers  CustomOffer[]

  @@index([categoryId])
  @@index([level])
  @@index([wilaya])
}

model FreelancerSkill {
  freelancerId String
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([freelancerId, skillId])
  @@index([skillId])
}

/// Identity documents. Separate from the profile so the document columns can
/// be read by the verification flow alone, and never join a public query.
model IdentityVerification {
  id String @id @default(uuid())

  freelancerId String            @unique
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  documentId String?
  document   FileAsset? @relation("VerificationDocument", fields: [documentId], references: [id], onDelete: SetNull)

  selfieId String?
  selfie   FileAsset? @relation("VerificationSelfie", fields: [selfieId], references: [id], onDelete: SetNull)

  state           ModerationState @default(PENDING)
  rejectionReason String?

  reviewedById String?
  reviewedBy   User?     @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////////
// SERVICES
//////////////////////////////////////////////////////////

model ServiceListing {
  id String @id @default(uuid())

  freelancerId String
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  title String
  slug  String @unique

  categoryId String?
  category   JobCategory? @relation("ServiceCategory", fields: [categoryId], references: [id], onDelete: SetNull)

  description String

  status ServiceStatus @default(DRAFT)

  rejectionReason String?

  /// How many times this service has been submitted for review.
  ///
  /// Part of the idempotency key for the publication charge. Without it
  /// the key is per service, so a refused service resubmitted after a fix
  /// matched the first charge and republished for free.
  publicationAttempts Int @default(0)

  publishedAt DateTime?
  /// Publication buys a window, not a permanent listing.
  expiresAt   DateTime?

  /// Public views only. Owner previews and edit screens are not traffic.
  views Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packages     ServicePackage[]
  addons       ServiceAddon[]
  faqs         ServiceFaq[]
  requirements ServiceRequirement[]
  media        ServiceMedia[]
  skills       ServiceSkill[]
  orders       FreelanceOrder[]
  boosts       Boost[]
  reports      Report[]

  @@index([freelancerId])
  @@index([categoryId])
  @@index([status, publishedAt])
  @@index([status, expiresAt])
}

model ServicePackage {
  id String @id @default(uuid())

  serviceId String
  service   ServiceListing @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  tier PackageTier

  name        String
  description String?

  price Decimal @db.Decimal(12, 2)

  deliveryDays Int
  revisions    Int @default(0)

  features String[]

  orders FreelanceOrder[]

  /// One package per tier per service, so "Standard" is unambiguous.
  @@unique([serviceId, tier])
}

model ServiceAddon {
  id String @id @default(uuid())

  serviceId String
  service   ServiceListing @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  name  String
  price Decimal @db.Decimal(12, 2)

  /// Days added to the package's delivery time when chosen.
  extraDays Int @default(0)

  orderAddons FreelanceOrderAddon[]

  @@index([serviceId])
}

model ServiceFaq {
  id String @id @default(uuid())

  serviceId String
  service   ServiceListing @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  question String
  answer   String
  position Int    @default(0)

  @@index([serviceId])
}

/// What the buyer must supply before work can start.
model ServiceRequirement {
  id String @id @default(uuid())

  serviceId String
  service   ServiceListing @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  prompt   String
  required Boolean @default(true)
  position Int     @default(0)

  @@index([serviceId])
}

model ServiceMedia {
  id String @id @default(uuid())

  serviceId String
  service   ServiceListing @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  fileId String
  file   FileAsset @relation("ServiceMedia", fields: [fileId], references: [id], onDelete: Cascade)

  position Int @default(0)

  @@index([serviceId])
}

model ServiceSkill {
  serviceId String
  service   ServiceListing @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([serviceId, skillId])
  @@index([skillId])
}

//////////////////////////////////////////////////////////
// CLIENT PROJECTS AND PROPOSALS
//////////////////////////////////////////////////////////

model FreelanceProject {
  id String @id @default(uuid())

  /// The client is a plain User: posting work needs no seller profile, and
  /// publishing a project is free.
  clientId String
  client   User   @relation("ProjectClient", fields: [clientId], references: [id], onDelete: Cascade)

  /// Set when an existing employer hires through their business account.
  companyId String?
  company   Company? @relation("ProjectCompany", fields: [companyId], references: [id], onDelete: SetNull)

  title       String
  slug        String @unique
  description String

  categoryId String?
  category   JobCategory? @relation("ProjectCategory", fields: [categoryId], references: [id], onDelete: SetNull)

  budgetType BudgetType @default(FIXED)
  budgetMin  Decimal?   @db.Decimal(12, 2)
  budgetMax  Decimal?   @db.Decimal(12, 2)

  deadline DateTime?

  remote Boolean @default(true)
  wilaya String?

  visibility ProjectVisibility      @default(PUBLIC)
  status     FreelanceProjectStatus @default(DRAFT)

  rejectionReason String?

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills      ProjectSkill[]
  attachments ProjectAttachment[]
  proposals   Proposal[]
  invites     ProjectInvite[]
  orders      FreelanceOrder[]
  reports     Report[]

  @@index([clientId])
  @@index([categoryId])
  @@index([status, publishedAt])
}

model ProjectSkill {
  projectId String
  project   FreelanceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
}

model ProjectAttachment {
  id String @id @default(uuid())

  projectId String
  project   FreelanceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fileId String
  file   FileAsset @relation("ProjectAttachment", fields: [fileId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Who may see an INVITE_ONLY project.
model ProjectInvite {
  projectId String
  project   FreelanceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  freelancerId String

  invitedAt DateTime @default(now())

  @@id([projectId, freelancerId])
}

model Proposal {
  id String @id @default(uuid())

  projectId String
  project   FreelanceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  freelancerId String
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  coverLetter String

  price        Decimal @db.Decimal(12, 2)
  deliveryDays Int

  status ProposalStatus @default(SENT)

  viewedAt      DateTime?
  shortlistedAt DateTime?
  decidedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments ProposalAttachment[]
  boosts      Boost[]

  /// One proposal per freelancer per project. The constraint, not a check in
  /// the handler, is what stops a double-submit charging twice.
  @@unique([projectId, freelancerId])
  @@index([freelancerId, status])
}

model ProposalAttachment {
  id String @id @default(uuid())

  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  fileId String
  file   FileAsset @relation("ProposalAttachment", fields: [fileId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

//////////////////////////////////////////////////////////
// ORDERS
//////////////////////////////////////////////////////////

model FreelanceOrder {
  id        String @id @default(uuid())
  reference String @unique

  clientId String
  client   User   @relation("OrderClient", fields: [clientId], references: [id], onDelete: Cascade)

  freelancerId String
  freelancer   FreelancerProfile @relation("OrderFreelancer", fields: [freelancerId], references: [id], onDelete: Cascade)

  /// An order comes from a purchased service package or from a hired
  /// proposal. Exactly one of these is set.
  serviceId String?
  service   ServiceListing? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  packageId String?
  package   ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  projectId String?
  project   FreelanceProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Priced by the server from the package and add-ons. A client-supplied
  /// total is never trusted.
  agreedPrice Decimal @db.Decimal(12, 2)
  currency    String  @default("DZD")

  deliveryDueAt DateTime?

  status FreelanceOrderStatus @default(CREATED)

  /// The platform does not hold the money for the work itself under the MVP
  /// model: the two sides settle directly. Revenue is credits and plans.
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  addons       FreelanceOrderAddon[]
  milestones   OrderMilestone[]
  deliveries   OrderDelivery[]
  events       OrderEvent[]
  reviews      FreelanceReview[]
  disputes     Dispute[]
  conversation Conversation?
  /// Set when this order came from an offer accepted in a conversation.
  customOffer  CustomOffer?

  @@index([clientId, status])
  @@index([freelancerId, status])
}

model FreelanceOrderAddon {
  id String @id @default(uuid())

  orderId String
  order   FreelanceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  addonId String?
  addon   ServiceAddon? @relation(fields: [addonId], references: [id], onDelete: SetNull)

  /// Copied at purchase: an add-on repriced later must not restate a past
  /// order's total.
  name  String
  price Decimal @db.Decimal(12, 2)

  @@index([orderId])
}

model OrderMilestone {
  id String @id @default(uuid())

  orderId String
  order   FreelanceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  title  String
  amount Decimal?  @db.Decimal(12, 2)
  dueAt  DateTime?

  status   MilestoneStatus @default(PENDING)
  position Int             @default(0)

  @@index([orderId])
}

model OrderDelivery {
  id String @id @default(uuid())

  orderId String
  order   FreelanceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  message String?

  /// Rises with each resubmission, so a revision history is readable.
  attempt Int @default(1)

  revisionRequested Boolean @default(false)
  revisionNote      String?

  acceptedAt DateTime?

  createdAt DateTime @default(now())

  files DeliveryFile[]

  @@index([orderId])
}

model DeliveryFile {
  id String @id @default(uuid())

  deliveryId String
  delivery   OrderDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  fileId String
  file   FileAsset @relation("DeliveryFile", fields: [fileId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
}

/// Append-only trail of status changes, so a dispute can be read rather than
/// reconstructed.
model OrderEvent {
  id String @id @default(uuid())

  orderId String
  order   FreelanceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation("OrderEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  fromStatus FreelanceOrderStatus?
  toStatus   FreelanceOrderStatus
  note       String?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

//////////////////////////////////////////////////////////
// REVIEWS
//////////////////////////////////////////////////////////

model FreelanceReview {
  id String @id @default(uuid())

  orderId String
  order   FreelanceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  targetId String
  target   User   @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)

  rating Int

  /// The published criteria, each 1-5 and optional on a client review.
  qualityRating       Int?
  communicationRating Int?
  deadlineRating      Int?

  comment String?

  /// One reply from the reviewed party, not a thread.
  response    String?
  respondedAt DateTime?

  state ModerationState @default(APPROVED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One review per person per order, enforced by the database rather than
  /// by a check that a retry can race.
  @@unique([orderId, authorId])
  @@index([targetId])
}

//////////////////////////////////////////////////////////
// MESSAGING
//////////////////////////////////////////////////////////

model Conversation {
  id String @id @default(uuid())

  /// Optional context, so a thread opened from a service or an order can say
  /// what it is about.
  orderId String?         @unique
  order   FreelanceOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
  customOffers CustomOffer[]

  @@index([updatedAt])
}

model ConversationParticipant {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt DateTime?

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  body String?

  /// Raised when a phone number or external link appears early in a thread.
  /// A signal for moderators, never an automatic ban.
  flagged    Boolean @default(false)
  flagReason String?

  createdAt DateTime @default(now())

  attachments MessageAttachment[]
  reports     Report[]

  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id String @id @default(uuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileId String
  file   FileAsset @relation("MessageAttachment", fields: [fileId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

//////////////////////////////////////////////////////////
// CREDITS
//////////////////////////////////////////////////////////

model CreditWallet {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A cache of the ledger, updated in the same transaction as the entry it
  /// follows. The ledger is the truth; this exists so a balance check is one
  /// row rather than a sum.
  balance Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries CreditLedgerEntry[]

  @@index([userId])
}

model CreditLedgerEntry {
  id String @id @default(uuid())

  walletId String
  wallet   CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type CreditEntryType

  /// Signed: negative spends, positive grants. Never zero.
  delta Int

  /// The balance after this entry, so history can be read without replaying
  /// every row before it.
  balanceAfter Int

  /// What caused it — a service id, a proposal id, a payment id.
  referenceType String?
  referenceId   String?

  note String?

  /// The guard against a retried request spending twice. A repeat of the
  /// same operation collides here instead of making a second entry.
  idempotencyKey String? @unique

  createdById String?
  createdBy   User?   @relation("LedgerActor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
}

/// Admin-editable, because the launch prices in the brief are proposals and
/// not confirmed market data.
model CreditPack {
  id String @id @default(uuid())

  name     String
  credits  Int
  price    Decimal @db.Decimal(12, 2)
  currency String  @default("DZD")

  active   Boolean @default(true)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments MarketplacePayment[]
}

//////////////////////////////////////////////////////////
// SUBSCRIPTIONS AND BOOSTS
//
// Separate from the recruiter Subscription model, which hangs off a Company
// and carries RecruiterPlan. A freelance plan belongs to a person and has
// different quotas; overloading one model would mean a nullable company and
// two meanings for every row.
//////////////////////////////////////////////////////////

model FreelancePlan {
  id String @id @default(uuid())

  tier FreelancePlanTier @unique

  name     String
  price    Decimal @db.Decimal(12, 2)
  currency String  @default("DZD")

  /// Null means unlimited, within the operational safeguards applied in code.
  maxActiveServices    Int?
  monthlyProposals     Int?
  maxPortfolioProjects Int?

  prioritySearch    Boolean @default(false)
  removableBranding Boolean @default(false)
  customSubdomain   Boolean @default(false)
  weeklyBoosts      Int     @default(0)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions FreelanceSubscription[]
}

model FreelanceSubscription {
  id String @id @default(uuid())

  freelancerId String
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String
  plan   FreelancePlan @relation(fields: [planId], references: [id])

  status FreelanceSubscriptionStatus @default(ACTIVE)

  startsAt DateTime
  endsAt   DateTime

  /// Reset when the period rolls over, so a quota is per period rather than
  /// per lifetime.
  proposalsUsedThisPeriod Int      @default(0)
  periodStartedAt         DateTime

  autoRenew Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments MarketplacePayment[]

  @@index([freelancerId, status])
}

model Boost {
  id String @id @default(uuid())

  freelancerId String
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  /// A boost promotes one service or one proposal.
  serviceId String?
  service   ServiceListing? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  proposalId String?
  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  placement BoostPlacement
  startsAt  DateTime
  endsAt    DateTime

  /// What was paid, kept with the boost so a later price change does not
  /// rewrite history.
  pricePaid   Decimal? @db.Decimal(12, 2)
  creditsPaid Int?

  createdAt DateTime @default(now())

  @@index([placement, startsAt, endsAt])
  @@index([freelancerId])
}

//////////////////////////////////////////////////////////
// MARKETPLACE PAYMENTS
//////////////////////////////////////////////////////////

model MarketplacePayment {
  id        String @id @default(uuid())
  reference String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A payment buys exactly one of these.
  creditPackId String?
  creditPack   CreditPack? @relation(fields: [creditPackId], references: [id], onDelete: SetNull)

  subscriptionId String?
  subscription   FreelanceSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("DZD")

  method MarketplacePaymentMethod
  status MarketplacePaymentStatus @default(PENDING)

  /// The gateway's own id. Unique so a replayed webhook cannot be processed
  /// a second time.
  providerCheckoutId String? @unique
  providerPayload    Json?

  paidAt DateTime?

  /// Manual transfers: the uploaded proof and the human who judged it. A
  /// screenshot alone never grants credits.
  receiptId String?
  receipt   FileAsset? @relation("PaymentReceipt", fields: [receiptId], references: [id], onDelete: SetNull)

  reviewedById    String?
  reviewedBy      User?     @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice         MarketplaceInvoice?
  promoRedemption PromoCodeRedemption?

  @@index([userId, status])
  @@index([status, createdAt])
}

model MarketplaceInvoice {
  id String @id @default(uuid())

  paymentId String             @unique
  payment   MarketplacePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  number String @unique

  issuedAt DateTime @default(now())

  /// The rendered document, once generated.
  fileId String?
  file   FileAsset? @relation("InvoiceFile", fields: [fileId], references: [id], onDelete: SetNull)
}

//////////////////////////////////////////////////////////
// PORTFOLIOS
//////////////////////////////////////////////////////////

model Portfolio {
  id String @id @default(uuid())

  freelancerId String            @unique
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  /// Draft until published. An unpublished portfolio is never served.
  published   Boolean   @default(false)
  publishedAt DateTime?

  template    String @default("default")
  accentColor String @default("#173E7D")
  fontFamily  String @default("default")

  /// Which language the public page renders in by default.
  defaultLanguage Language @default(FR)

  seoTitle       String?
  seoDescription String?

  coverId String?
  cover   FileAsset? @relation("PortfolioCover", fields: [coverId], references: [id], onDelete: SetNull)

  /// Public page views only.
  views Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections PortfolioSection[]
  projects PortfolioProject[]
}

model PortfolioSection {
  id String @id @default(uuid())

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  type     PortfolioSectionType
  visible  Boolean              @default(true)
  position Int                  @default(0)

  /// Per-language overrides for the heading and body of this section.
  content Json?

  @@unique([portfolioId, type])
}

model PortfolioProject {
  id String @id @default(uuid())

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  title       String
  description String?

  categoryId String?
  category   JobCategory? @relation("PortfolioProjectCategory", fields: [categoryId], references: [id], onDelete: SetNull)

  role        String?
  tools       String[]
  clientName  String?
  externalUrl String?
  /// YouTube or Vimeo, kept as a link rather than a re-hosted file.
  videoUrl    String?

  completedAt DateTime?

  /// At most three, enforced in code against the plan's limit.
  featured Boolean @default(false)
  position Int     @default(0)

  coverId String?
  cover   FileAsset? @relation("PortfolioProjectCover", fields: [coverId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media PortfolioProjectMedia[]

  @@index([portfolioId])
}

model PortfolioProjectMedia {
  id String @id @default(uuid())

  projectId String
  project   PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fileId String
  file   FileAsset @relation("PortfolioMedia", fields: [fileId], references: [id], onDelete: Cascade)

  position Int @default(0)

  @@index([projectId])
}

//////////////////////////////////////////////////////////
// MODERATION, REPORTS, DISPUTES
//////////////////////////////////////////////////////////

/// One row per moderator decision, on whatever was judged. Kept apart from
/// the moderated record so a history survives edits and resubmissions.
model ModerationRecord {
  id String @id @default(uuid())

  entityType String
  entityId   String

  state  ModerationState
  reason String?

  moderatorId String?
  moderator   User?   @relation("ModerationActor", fields: [moderatorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([state, createdAt])
}

model Report {
  id String @id @default(uuid())

  reporterId String
  reporter   User   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  /// Exactly one target is set.
  serviceId String?
  service   ServiceListing? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  projectId String?
  project   FreelanceProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  reportedUserId String?
  reportedUser   User?   @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)

  reason ReportReason
  detail String?

  status ReportStatus @default(OPEN)

  /// A report is private to the reporter and to staff. It is never shown on
  /// the thing it is about.
  resolvedById String?
  resolvedBy   User?     @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  resolution   String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model Dispute {
  id String @id @default(uuid())

  orderId String
  order   FreelanceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  openedById String
  openedBy   User   @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Cascade)

  subject String
  detail  String

  status DisputeStatus @default(OPEN)

  assignedToId String?
  assignedTo   User?   @relation("DisputeAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  resolution String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([orderId])
}

//////////////////////////////////////////////////////////
// FREELANCE — SECOND INCREMENT
//
// Added after reading the specification PDF, which names several things the
// first pass missed: favourites, custom offers sent from a conversation,
// promo codes, internal staff roles with separate rights, the CMS behind the
// help centre and legal pages, and the phone and company verification badges
// that sit beside identity verification.
//////////////////////////////////////////////////////////

enum FavoriteTargetType {
  SERVICE
  FREELANCER
  PROJECT
}

enum CustomOfferStatus {
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum PromoCodeKind {
  PERCENT_OFF
  AMOUNT_OFF
  BONUS_CREDITS
}

/// The four internal roles the specification names, each with its own rights.
/// Distinct from the public Role enum, which says what kind of account this
/// is rather than what a member of staff may do.
enum StaffRole {
  ADMINISTRATOR
  MODERATOR
  FINANCE
  SUPPORT
}

enum CmsContentType {
  LEGAL_PAGE
  HELP_ARTICLE
  HOMEPAGE_BANNER
  EMAIL_TEMPLATE
  SMS_TEMPLATE
}

//////////////////////////////////////////////////////////
// FAVOURITES
//////////////////////////////////////////////////////////

/// "Services et freelances enregistrés en favoris" — the client area's
/// Favoris page. One table with a typed target rather than three, because
/// the page lists them together and nothing differs but the target.
model Favorite {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetType FavoriteTargetType
  targetId   String

  createdAt DateTime @default(now())

  /// Saving the same thing twice is the same favourite.
  @@unique([userId, targetType, targetId])
  @@index([userId, createdAt])
}

//////////////////////////////////////////////////////////
// CUSTOM OFFERS
//////////////////////////////////////////////////////////

/// "Envoi d'offres personnalisées depuis la discussion" — a freelancer
/// proposes a price and a deadline inside a conversation, and accepting it
/// creates an order. The third way an order begins, beside a purchased
/// package and a hired proposal.
model CustomOffer {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  freelancerId String
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  clientId String
  client   User   @relation("CustomOfferClient", fields: [clientId], references: [id], onDelete: Cascade)

  title       String
  description String?

  price        Decimal @db.Decimal(12, 2)
  deliveryDays Int
  revisions    Int     @default(0)

  status CustomOfferStatus @default(SENT)

  expiresAt   DateTime?
  respondedAt DateTime?

  /// Set once accepted, so an offer cannot be turned into two orders.
  orderId String?         @unique
  order   FreelanceOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([freelancerId, status])
}

//////////////////////////////////////////////////////////
// PROMO CODES
//////////////////////////////////////////////////////////

model PromoCode {
  id String @id @default(uuid())

  code String @unique

  kind PromoCodeKind

  /// Read according to `kind`: a percentage, an amount in DZD, or a number
  /// of bonus credits.
  value Decimal @db.Decimal(12, 2)

  /// Null means no limit.
  maxRedemptions  Int?
  maxPerUser      Int? @default(1)
  redemptionCount Int  @default(0)

  startsAt DateTime?
  endsAt   DateTime?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions PromoCodeRedemption[]
}

model PromoCodeRedemption {
  id String @id @default(uuid())

  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  paymentId String?             @unique
  payment   MarketplacePayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([promoCodeId])
  @@index([userId])
}

//////////////////////////////////////////////////////////
// INTERNAL STAFF
//////////////////////////////////////////////////////////

/// Who on the team may do what. The specification separates administrator,
/// moderator, finance and support, "chacun avec ses propres droits": a
/// moderator must not be able to approve a payment.
///
/// Permissions are stored as a list of granted capability strings rather than
/// implied by the role, so a role can be tightened without a migration and
/// every check reads the same way.
model StaffMember {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role StaffRole

  /// Capability names such as "moderation.approve", "payments.refund".
  permissions String[]

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

/// "Se connecter en tant qu'utilisateur pour le support". Every impersonation
/// is a row: who, whom, when, and why. A support tool that leaves no trace is
/// indistinguishable from an account takeover.
model ImpersonationSession {
  id String @id @default(uuid())

  staffId String
  staff   User   @relation("ImpersonationStaff", fields: [staffId], references: [id], onDelete: Cascade)

  targetUserId String
  targetUser   User   @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  reason String?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([staffId, startedAt])
  @@index([targetUserId, startedAt])
}

//////////////////////////////////////////////////////////
// CMS
//////////////////////////////////////////////////////////

/// Legal pages, help articles, homepage banners and message templates, all
/// editable from the back-office. One table with a typed kind: they differ in
/// where they are shown, not in what they hold.
///
/// Bodies are per language, because the legal pages must exist in Arabic and
/// French and the specification treats that as a requirement rather than a
/// nicety.
model CmsContent {
  id String @id @default(uuid())

  type CmsContentType
  slug String

  /// { "fr": { "title": "...", "body": "..." }, "ar": { ... } }
  translations Json

  /// Banners and articles are ordered; pages are not.
  position Int @default(0)

  published   Boolean   @default(false)
  publishedAt DateTime?

  updatedById String?
  updatedBy   User?   @relation("CmsEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, slug])
  @@index([type, published, position])
}
